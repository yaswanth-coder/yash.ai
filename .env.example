# Database Configuration (MongoDB URI & DB Name)
MONGODB_URI=mongodb+srv://yaseanth12345_db_user:<kS3Zd1f3KNs9NX0W>@cluster0.p1jzks2.mongodb.net/?appName=Cluster0
MONGODB_DB_NAME=yash_ai
MONGODB_DB_NAME=yash_ai

# Security & Authentication
JWT_SECRET_KEY=generate-a-secure-random-secret-key-here-for-production
JWT_ALGORITHM=HS256

# AI Providers & Model Gateway
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

GROQ_API_KEY=your_groq_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Local AI (Ollama)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3

# Provider Routing Priority (comma-separated: gemini,ollama,groq,anthropic,openai)
AI_PROVIDER_PRIORITY=gemini,ollama,groq,anthropic,openai
CORS_ORIGINS=http://localhost:3000
